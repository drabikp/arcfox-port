From 37b231fc6bff7f56eea4d612e32e488c89049f1f Mon Sep 17 00:00:00 2001
From: drabikp <drabik.p@gmail.com>
Date: Tue, 1 Sep 2026 11:06:54 +0200
Subject: [PATCH 2/3] DigitalAppWidget: widen the date line's share of the
 widget

The date font is derived from the clock font by a fixed divisor. AOSP uses
5.5; on arcfox's 1080x1272 cover panel that lands the date at a size that
clips against the clock above it. 4 gives the date the room it needs on that
panel.

This is a device-shaped constant, unlike the sizing fix it sits on top of, and
is kept as a separate change so the upstreamable half can be sent on its own.

Assisted-by: Claude-Code:claude-opus-5
Change-Id: I9f17290f4b87d9168f8ef14d4ab69d41af0f3694
---
 src/com/android/alarmclock/DigitalAppWidgetProvider.java | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/src/com/android/alarmclock/DigitalAppWidgetProvider.java b/src/com/android/alarmclock/DigitalAppWidgetProvider.java
index 7f21c7472..e16ce8c22 100644
--- a/src/com/android/alarmclock/DigitalAppWidgetProvider.java
+++ b/src/com/android/alarmclock/DigitalAppWidgetProvider.java
@@ -633,7 +633,11 @@ public class DigitalAppWidgetProvider extends AppWidgetProvider {
         private int getClockFontSizePx() { return mClockFontSizePx; }
         private void setClockFontSizePx(int clockFontSizePx) {
             mClockFontSizePx = clockFontSizePx;
-            mFontSizePx = max(1, round(clockFontSizePx / 5.5f));
+            // arcfox: AOSP uses /5.5f. On the 1080x1272 cover panel the clock font lands
+            // at ~101px, so the date rendered at ~18px (~8dp) and was unreadable.
+            // /4f gives ~25px (~11dp) there and ~45px on the inner panel. The
+            // optimizer fits clock+date together, so the clock shrinks slightly.
+            mFontSizePx = max(1, round(clockFontSizePx / 4f));
             mIconFontSizePx = (int) (mFontSizePx * 1.4f);
             mIconPaddingPx = mFontSizePx / 3;
         }
-- 
