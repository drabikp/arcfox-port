 public class DigitalAppWidgetProvider extends AppWidgetProvider {
 
+    /** Matches RemoteViews.MAX_INIT_VIEW_COUNT; more entries would throw. */
+    private static final int MAX_SIZED_REMOTE_VIEWS = 16;
+
+    /**
+     * Widget size, in dp, of last resort. Only used when the host gave us no size at all *and*
+     * the provider info could not be read; it exists purely so the clock is never laid out for a
+     * 0x0 box, which collapses the font to 1px.
+     */
+    private static final float FALLBACK_WIDGET_SIZE_DP = 40f;
+
     private static final LogUtils.Logger LOGGER = new LogUtils.Logger("DigitalWidgetProvider");
 
     private static boolean sReceiversRegistered;
@@ -203,27 +216,113 @@ public class DigitalAppWidgetProvider extends AppWidgetProvider {
     }
 
     /**
-     * Compute optimal font and icon sizes offscreen for both portrait and landscape orientations
-     * using the last known widget size and apply them to the widget.
+     * Compute optimal font and icon sizes offscreen for every set of bounds the host says it may
+     * give this widget, and apply them all so the host can pick the one that matches its real
+     * bounds.
      */
     private static void relayoutWidget(Context context, AppWidgetManager wm, int widgetId,
             Bundle options) {
-        final RemoteViews portrait = relayoutWidget(context, wm, widgetId, options, true);
-        final RemoteViews landscape = relayoutWidget(context, wm, widgetId, options, false);
-        final RemoteViews widget = new RemoteViews(landscape, portrait);
+        if (options == null) {
+            options = wm.getAppWidgetOptions(widgetId);
+        }
+
+        // OPTION_APPWIDGET_MIN_* / OPTION_APPWIDGET_MAX_* only describe the widget correctly when
+        // the host has a single set of bounds that differ by orientation. Launchers on devices
+        // with more than one internal display (foldables and flip phones) aggregate those four
+        // values over *every* supported device profile, so OPTION_APPWIDGET_MAX_HEIGHT can be the
+        // height this widget would have on a display it is not currently being drawn on. Sizing
+        // the clock against that value makes the text far too large for the real widget bounds,
+        // where it is then clipped by the parent LinearLayout. Neither MAX_* value is read
+        // anywhere below.
+        //
+        // OPTION_APPWIDGET_SIZES (API 31+) carries the exact list of sizes the host may use, so
+        // build one RemoteViews per size and let the host pick the one matching its real bounds.
+        final List<SizeF> sizes = options.getParcelableArrayList(OPTION_APPWIDGET_SIZES,
+                SizeF.class);
+
+        // The host does not know the widget's size until it has laid it out once, and until then
+        // RemoteViews.getRemoteViewsToApply() falls back to the entry with the smallest *area* --
+        // which is not necessarily an entry that fits. Always add a synthetic entry holding the
+        // component-wise minimum of everything the host advertised: it has the smallest area of
+        // the whole map by construction, so it becomes that fallback, and it fits inside every
+        // size the host may pick, so it can never be clipped. It is also the only entry when the
+        // host gave us no size list at all.
+        final SizeF smallestDp = getSmallestSizeDp(context, wm, widgetId, options, sizes);
+
+        final Map<SizeF, RemoteViews> viewsBySize = new LinkedHashMap<>();
+        viewsBySize.put(smallestDp, relayoutWidget(context, wm, widgetId, smallestDp));
+        if (sizes != null) {
+            for (SizeF size : sizes) {
+                if (size == null || size.getWidth() <= 0f || size.getHeight() <= 0f
+                        || viewsBySize.containsKey(size)
+                        || viewsBySize.size() >= MAX_SIZED_REMOTE_VIEWS) {
+                    continue;
+                }
+                viewsBySize.put(size, relayoutWidget(context, wm, widgetId, size));
+            }
+        }
+
+        final RemoteViews widget = viewsBySize.size() == 1
+                ? viewsBySize.values().iterator().next()
+                : new RemoteViews(viewsBySize);
+
         wm.updateAppWidget(widgetId, widget);
         wm.notifyAppWidgetViewDataChanged(widgetId, R.id.world_city_list);
     }
 
+    /**
+     * @return the component-wise smallest size, in dp, that the host may give this widget. A
+     *     layout built for it fits inside every size the host advertised, on either display.
+     */
+    private static SizeF getSmallestSizeDp(Context context, AppWidgetManager wm, int widgetId,
+            Bundle options, List<SizeF> sizes) {
+        // OPTION_APPWIDGET_MIN_WIDTH / MIN_HEIGHT are the minima over every supported device
+        // profile, so they are always safe to use. Their MAX_* counterparts are not.
+        float widthDp = options.getInt(OPTION_APPWIDGET_MIN_WIDTH);
+        float heightDp = options.getInt(OPTION_APPWIDGET_MIN_HEIGHT);
+
+        if (sizes != null) {
+            for (SizeF size : sizes) {
+                if (size == null || size.getWidth() <= 0f || size.getHeight() <= 0f) {
+                    continue;
+                }
+                widthDp = widthDp > 0f ? Math.min(widthDp, size.getWidth()) : size.getWidth();
+                heightDp = heightDp > 0f ? Math.min(heightDp, size.getHeight()) : size.getHeight();
+            }
+        }
+
+        // A widget that was bound without an options bundle -- which is what Launcher3 does for
+        // the widgets in its default workspace, see DefaultLayoutParser -- has no size
+        // information at all until its host gets around to publishing some, and Bundle.getInt()
+        // then returns 0 for every key. Laying the clock out for a 0x0 box makes optimizeSizes()
+        // bottom out at a 1px font, so fall back to the size declared in appwidget-provider XML.
+        if (widthDp <= 0f || heightDp <= 0f) {
+            final float density = context.getResources().getDisplayMetrics().density;
+            final AppWidgetProviderInfo info = wm.getAppWidgetInfo(widgetId);
+            if (info != null) {
+                // AppWidgetManager.getAppWidgetInfo() converts these to px before returning.
+                if (widthDp <= 0f && info.minWidth > 0) {
+                    widthDp = info.minWidth / density;
+                }
+                if (heightDp <= 0f && info.minHeight > 0) {
+                    heightDp = info.minHeight / density;
+                }
+            }
+        }
+
+        return new SizeF(widthDp > 0f ? widthDp : FALLBACK_WIDGET_SIZE_DP,
+                heightDp > 0f ? heightDp : FALLBACK_WIDGET_SIZE_DP);
+    }
+
     public static void updateAppWidget(Context context, AppWidgetManager wm, int widgetId) {
         relayoutWidget(context, wm, widgetId, wm.getAppWidgetOptions(widgetId));
     }
 
