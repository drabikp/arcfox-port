--- $HOME/android/kernel-src/xiaomi-base-backup/sm8635-modules.xiaomi-base/qcom/opensource/display-drivers/msm/Kbuild	2026-08-18 15:15:49.611865432 +0200
+++ $HOME/android/arcfox/kernel/motorola/sm8635-modules/qcom/opensource/display-drivers/msm/Kbuild	2026-08-27 23:42:39.897249692 +0200
@@ -91,7 +91,14 @@
 ifeq (1, $(strip $(CONFIG_DISPLAY_FACTORY_BUILD)))
 CDEFINES +=	-DDISPLAY_FACTORY_BUILD
 endif
+# arcfox: Xiaomi display extensions are OFF. mi_disp/mi_dsi_panel.c calls
+# mi_display_pwrkey_callback_set(), which exists only as a Xiaomi patch to
+# drivers/input/misc/pm8941-pwrkey.c in their kernel. Motorola's kernel-msm has
+# no such patch, so linking mi_disp against it fails modpost with that symbol
+# undefined. arcfox wants none of these extensions.
+ifeq ($(strip $(MI_DISPLAY_MODIFY)),y)
 CDEFINES +=	-DMI_DISPLAY_MODIFY
+endif
 KBUILD_CPPFLAGS += $(CDEFINES)
 
 ccflags-y += $(LINUX_INC)
@@ -277,6 +284,7 @@
 			     msm_smmu.o \
 			     msm_prop.o
 
+ifeq ($(strip $(MI_DISPLAY_MODIFY)),y)
 msm_drm-$(CONFIG_DRM_MSM) += mi_disp/mi_disp_core.o \
 			     mi_disp/mi_disp_feature.o \
 			     mi_disp/mi_disp_sysfs.o \
@@ -294,4 +302,5 @@
 			     mi_disp/mi_sde_crtc.o \
 			     mi_disp/mi_sde_encoder.o \
 			     mi_disp/mi_sde_connector.o
+endif
 
