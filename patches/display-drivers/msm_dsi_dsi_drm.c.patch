+/*
+ * Motorola panel sysfs compatibility layer.
+ *
+ * arcfox's vendor userspace reads a small set of Motorola-specific attributes
+ * from the primary DSI connector. Motorola implements these in their own
+ * display-drivers techpack, which is NOT published for the MMI-W1UXS36H
+ * build train (vendor-qcom-opensource-display-drivers stops at MMI-T1TR33,
+ * kernel-msm-techpack-display at S1SUS32). The panel itself needs nothing
+ * from that tree -- arcfox's panel is plain data: every one of the 297
+ * properties in dsi-panel-mot-csot-nt37707-667-1080x2640-dsc-cmd-common_v3.dtsi
+ * is a standard qcom,* property, so the generic dsi_panel parser drives it.
+ * Only these sysfs nodes were missing.
+ *
+ * Contract captured from the running stock-module device, card0-DSI-1:
+ *   panelName               csot_nt37707_667_1080x2640_dsc_cmd_v3
+ *   panelSupplier           csot
+ *   panelCellId             (empty)
+ *   panelBLExponent         1
+ *   panelVer                0x0000000000000000
+ *   panelDC                 0
+ *   panelPcdCheck           0
+ *   panelEnableSfBrightZone 15
+ * panelDeclare does NOT exist on stock -- init.mmi.touch.sh probes it and
+ * tolerates absence, so it is deliberately not created here.
+ * The cover panel (card0-DSI-2) carries NONE of these on stock either.
+ *
+ * panelName is the panel's DT node name with the "qcom,mdss_dsi_mot_" prefix
+ * stripped, which reproduces the stock string exactly. panelSupplier and
+ * panelBLExponent come from real DT properties.
+ */
+#define MOT_PANEL_NODE_PREFIX "qcom,mdss_dsi_mot_"
+
+static struct dsi_panel *mot_sysfs_panel(struct device *dev)
+{
+	/* DRM stores the connector as the sysfs device's drvdata */
+	struct drm_connector *conn = dev_get_drvdata(dev);
+	struct sde_connector *c_conn;
+
+	if (!conn)
+		return NULL;
+	c_conn = to_sde_connector(conn);
+	if (!c_conn || !c_conn->display)
+		return NULL;
+	return ((struct dsi_display *)c_conn->display)->panel;
+}
+
+static ssize_t panelName_show(struct device *dev,
+		struct device_attribute *attr, char *buf)
+{
+	struct dsi_panel *panel = mot_sysfs_panel(dev);
+	const char *n;
+
+	if (!panel || !panel->panel_of_node)
+		return scnprintf(buf, PAGE_SIZE, "\n");
+	n = panel->panel_of_node->name;
+	if (!strncmp(n, MOT_PANEL_NODE_PREFIX, strlen(MOT_PANEL_NODE_PREFIX)))
+		n += strlen(MOT_PANEL_NODE_PREFIX);
+	return scnprintf(buf, PAGE_SIZE, "%s\n", n);
+}
+
+static ssize_t panelSupplier_show(struct device *dev,
+		struct device_attribute *attr, char *buf)
+{
+	struct dsi_panel *panel = mot_sysfs_panel(dev);
+	const char *sup = NULL;
+
+	if (panel && panel->panel_of_node)
+		sup = of_get_property(panel->panel_of_node,
+				"qcom,mdss-dsi-panel-supplier", NULL);
+	return scnprintf(buf, PAGE_SIZE, "%s\n", sup ? sup : "");
+}
+
+static ssize_t panelBLExponent_show(struct device *dev,
+		struct device_attribute *attr, char *buf)
+{
+	struct dsi_panel *panel = mot_sysfs_panel(dev);
+	bool exp = false;
+
+	if (panel && panel->panel_of_node)
+		exp = of_property_read_bool(panel->panel_of_node,
+				"qcom,mdss-dsi-bl-is-exponent");
+	return scnprintf(buf, PAGE_SIZE, "%d\n", exp ? 1 : 0);
+}
+
+/*
+ * panelCellId / panelVer / panelId are read back from the panel over DSI by
+ * Motorola's driver (cf. its sibling panelRegDA node). We do not have that
+ * read protocol, so expose the values stock reports on this device: cellId is
+ * EMPTY on arcfox (its read path is the NT37705A one, a different panel), and
+ * ver reads back zero. panelId is overridable from DT so the correct value can
+ * be supplied without patching code.
+ */
+static ssize_t panelCellId_show(struct device *dev,
+		struct device_attribute *attr, char *buf)
+{
+	return scnprintf(buf, PAGE_SIZE, "\n");
+}
+
+static ssize_t panelVer_show(struct device *dev,
+		struct device_attribute *attr, char *buf)
+{
+	return scnprintf(buf, PAGE_SIZE, "0x%016llx\n", 0ULL);
+}
+
+static ssize_t panelId_show(struct device *dev,
+		struct device_attribute *attr, char *buf)
+{
+	struct dsi_panel *panel = mot_sysfs_panel(dev);
+	u64 id = 0;
+
+	if (panel && panel->panel_of_node)
+		of_property_read_u64(panel->panel_of_node, "mot,panel-id", &id);
+	return scnprintf(buf, PAGE_SIZE, "0x%016llx\n", id);
+}
+
+static ssize_t panelDC_show(struct device *dev,
+		struct device_attribute *attr, char *buf)
+{
+	return scnprintf(buf, PAGE_SIZE, "%d\n", 0);
+}
+
+static ssize_t panelPcdCheck_show(struct device *dev,
+		struct device_attribute *attr, char *buf)
+{
+	return scnprintf(buf, PAGE_SIZE, "%d\n", 0);
+}
+
+static ssize_t panelEnableSfBrightZone_show(struct device *dev,
+		struct device_attribute *attr, char *buf)
+{
+	struct dsi_panel *panel = mot_sysfs_panel(dev);
+	u32 v = 15;
+
+	if (panel && panel->panel_of_node)
+		of_property_read_u32(panel->panel_of_node,
+				"mot,panel-sf-bright-zone", &v);
+	return scnprintf(buf, PAGE_SIZE, "%u\n", v);
+}
+
+static DEVICE_ATTR_RO(panelName);
+static DEVICE_ATTR_RO(panelSupplier);
+static DEVICE_ATTR_RO(panelCellId);
+static DEVICE_ATTR_RO(panelBLExponent);
+static DEVICE_ATTR_RO(panelVer);
+static DEVICE_ATTR_RO(panelId);
+static DEVICE_ATTR_RO(panelDC);
+static DEVICE_ATTR_RO(panelPcdCheck);
+static DEVICE_ATTR_RO(panelEnableSfBrightZone);
+
+static struct attribute *mot_panel_attrs[] = {
+	&dev_attr_panelName.attr,
+	&dev_attr_panelSupplier.attr,
+	&dev_attr_panelCellId.attr,
+	&dev_attr_panelBLExponent.attr,
+	&dev_attr_panelVer.attr,
+	&dev_attr_panelId.attr,
+	&dev_attr_panelDC.attr,
+	&dev_attr_panelPcdCheck.attr,
+	&dev_attr_panelEnableSfBrightZone.attr,
+	NULL,
+};
+
+static const struct attribute_group mot_panel_attr_group = {
+	.attrs = mot_panel_attrs,
+};
+
+/*
+ * Only the PRIMARY display gets these, matching stock: on arcfox the cover
+ * panel (card0-DSI-2) exposes none of them.
+ */
+static void dsi_conn_create_mot_sysfs(struct dsi_display *display,
+		struct drm_connector *connector)
+{
+	int rc;
+
+	if (!display || !connector || !connector->kdev)
+		return;
+	if (display->mot_sysfs_created)
+		return;
+	/* stock exposes these only on the primary panel, not the cover */
+	if (!display->display_type ||
+	    strcmp(display->display_type, "primary"))
+		return;
+
+	rc = sysfs_create_group(&connector->kdev->kobj, &mot_panel_attr_group);
+	if (rc) {
+		DSI_ERR("failed to create Motorola panel sysfs, rc=%d\n", rc);
+		return;
+	}
+	display->mot_sysfs_created = true;
+}
