# arcfox: sign ALL modules at modules_install with the build's ephemeral key.
# pineapple_GKI.config explicitly unsets MODULE_SIG_ALL and gki uses sha1;
# shipped GKI modules are sha256. A self-built Image must carry its own signed
# system_dlkm (the prebuilt's are bound to Google's build key) -- proven on
# device 2026-08-28: unsigned mac802154 -> -EACCES "exports protected symbol".
# ⚠️ Image and modules MUST build in ONE invocation/output dir: a fresh O=
# regenerates certs/signing_key.pem and silently invalidates every signature.
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_SHA256=y
