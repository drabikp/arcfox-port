+            // puts the panel's bottom edge on the right, rotation 270 on the left.
+            val side = res.getDimensionPixelSize(R.dimen.taskbar_covered_side_inset_landscape)
+            provider.insetsSize =
+                when {
+                    side > 0 && endRotation == Surface.ROTATION_90 -> Insets.of(0, 0, side, 0)
+                    side > 0 && endRotation == Surface.ROTATION_270 -> Insets.of(side, 0, 0, 0)
