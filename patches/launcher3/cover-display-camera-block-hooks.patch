         val res = context.resources
+        if (provider.type == navigationBars() && provider.index == INDEX_COVERED_SIDE) {
+            // Device hook: on a panel whose bottom corner is physically covered (cover display
+            // camera block), reserve that side in landscape as a navigation-bar inset, the way a
