From 42ed06305a6755bba7cc3064e885faa1f8de21a2 Mon Sep 17 00:00:00 2001
From: Peter Drabik <drabikp@posam.sk>
Date: Mon, 14 Sep 2026 10:54:23 +0200
Subject: [PATCH] Device hooks for panels with a physically covered bottom
 corner

Three resource-gated hooks, all default off, for a device whose display has
a camera block inside the panel at the bottom (a flip phone's cover display):

- hotseat_bar_bottom_space_extra: extra bottom space under the hotseat so
  the dock sits above the covered area.
- taskbar_ime_bottom_inset_override (+ _enabled): report a larger
  navigationBars inset to the IME window only, so the keyboard's bottom row
  sits above the covered area while apps keep the real bar height. The
  override entry is always present once enabled and only its size varies;
  WindowManager rejects a relayout that changes the set of override types
  after the window is added, and the taskbar window survives fold/unfold
  display switches.
- all_apps_ignore_workspace_scale: keep the all-apps grid at its configured
  size when the workspace is scaled down to fit a short panel. All-apps
  scrolls and never has to fit; on a 565dp panel sharing a 4x5 grid the
  upstream behaviour gave 37dp icons with 7dp labels.

Change-Id: I10c4b06c2848bd43a2e912682909c151084602d8
---
 .../taskbar/TaskbarInsetsController.kt        | 25 +++++++++++++++++++
 res/values/dimens.xml                         | 11 ++++++++
 src/com/android/launcher3/DeviceProfile.java  |  3 +++
 .../launcher3/deviceprofile/AllAppsProfile.kt | 14 ++++++++---
 4 files changed, 50 insertions(+), 3 deletions(-)

diff --git a/quickstep/src/com/android/launcher3/taskbar/TaskbarInsetsController.kt b/quickstep/src/com/android/launcher3/taskbar/TaskbarInsetsController.kt
index 0c8326072f..ec12a8ca08 100644
--- a/quickstep/src/com/android/launcher3/taskbar/TaskbarInsetsController.kt
+++ b/quickstep/src/com/android/launcher3/taskbar/TaskbarInsetsController.kt
@@ -42,12 +42,14 @@ import android.view.WindowInsets.Type.navigationBars
 import android.view.WindowInsets.Type.systemGestures
 import android.view.WindowInsets.Type.tappableElement
 import android.view.WindowManager
+import android.view.WindowManager.LayoutParams.TYPE_INPUT_METHOD
 import android.view.WindowManager.LayoutParams.TYPE_VOICE_INTERACTION
 import androidx.annotation.VisibleForTesting
 import androidx.core.graphics.toRegion
 import com.android.app.tracing.traceSection
 import com.android.internal.policy.GestureNavigationSettingsObserver
 import com.android.launcher3.DeviceProfile
+import com.android.launcher3.R
 import com.android.launcher3.anim.AlphaUpdateListener
 import com.android.launcher3.taskbar.TaskbarControllers.LoggableTaskbarController
 import com.android.launcher3.taskbar.TaskbarInsetsController.DebugTouchableRegion.Companion.DEFAULT_TOUCH_REGION
@@ -238,6 +240,29 @@ class TaskbarInsetsController(val context: TaskbarActivityContext) : LoggableTas
         val res = context.resources
         if (provider.type == navigationBars()) {
             provider.insetsSize = getInsetsForGravityWithCutout(contentHeight, gravity, endRotation)
+            // Device hook: report a larger bottom inset to the IME window only, so the keyboard
+            // stays clear of a physically covered bottom corner (cover display camera block).
+            // Gated by a boolean that must NOT vary per panel: WindowManager rejects a relayout
+            // that changes the SET of override types after the window is added, and this
+            // window survives display switches (fold/unfold). When enabled the entry is always
+            // present and only its size varies; the lift applies in portrait with the bar at
+            // the bottom, otherwise the entry repeats the normal navigationBars size.
+            if (res.getBoolean(R.bool.taskbar_ime_bottom_inset_override_enabled)) {
+                val imeOverride =
+                    res.getDimensionPixelSize(R.dimen.taskbar_ime_bottom_inset_override)
+                val imeInsets =
+                    if (
+                        imeOverride > 0 &&
+                            endRotation == Surface.ROTATION_0 &&
+                            (gravity and Gravity.BOTTOM) == Gravity.BOTTOM
+                    ) {
+                        Insets.of(0, 0, 0, maxOf(contentHeight, imeOverride))
+                    } else {
+                        provider.insetsSize
+                    }
+                provider.insetsSizeOverrides =
+                    arrayOf(InsetsFrameProvider.InsetsSizeOverride(TYPE_INPUT_METHOD, imeInsets))
+            }
         } else if (provider.type == mandatorySystemGestures()) {
             if (context.isThreeButtonNav) {
                 provider.insetsSize =
diff --git a/res/values/dimens.xml b/res/values/dimens.xml
index 4aaf95efb3..9fcf34c669 100644
--- a/res/values/dimens.xml
+++ b/res/values/dimens.xml
@@ -454,6 +454,17 @@
 
     <!-- Taskbar related (placeholders to compile in Launcher3 without Quickstep) -->
     <dimen name="taskbar_size">0dp</dimen>
+    <!-- Device hooks for panels whose bottom corner is physically covered (cover display
+         with a rear camera block): extra bottom space under the hotseat, and a larger
+         navigationBars inset reported to the IME window only, so the keyboard sits above
+         the covered area while apps keep the real bar height. Both default to 0dp. -->
+    <dimen name="hotseat_bar_bottom_space_extra">0dp</dimen>
+    <dimen name="taskbar_ime_bottom_inset_override">0dp</dimen>
+    <!-- Must be the same on every panel of a device (see TaskbarInsetsController). -->
+    <bool name="taskbar_ime_bottom_inset_override_enabled">false</bool>
+    <!-- Keep the all-apps grid at its configured size on panels where the workspace
+         has to be scaled down to fit (see AllAppsProfile). -->
+    <bool name="all_apps_ignore_workspace_scale">false</bool>
     <dimen name="taskbar_phone_size">@*android:dimen/navigation_bar_frame_height</dimen>
     <dimen name="taskbar_phone_home_button_size">80dp</dimen>
     <dimen name="taskbar_phone_content_padding">8dp</dimen>
diff --git a/src/com/android/launcher3/DeviceProfile.java b/src/com/android/launcher3/DeviceProfile.java
index ce25f40ce6..281af28680 100644
--- a/src/com/android/launcher3/DeviceProfile.java
+++ b/src/com/android/launcher3/DeviceProfile.java
@@ -400,6 +400,9 @@ public class DeviceProfile {
                 hotseatBarBottomSpacePx = hotseatBarBottomSpace;
             }
         }
+        // Device hook: extra space under the hotseat, for panels whose bottom corner is
+        // physically covered (e.g. a cover display with a rear camera block). Default 0dp.
+        hotseatBarBottomSpacePx += res.getDimensionPixelSize(R.dimen.hotseat_bar_bottom_space_extra);
 
         if (mIsResponsiveGrid) {
             updateHotseatSizes(mResponsiveWorkspaceCellSpec.getIconSize());
diff --git a/src/com/android/launcher3/deviceprofile/AllAppsProfile.kt b/src/com/android/launcher3/deviceprofile/AllAppsProfile.kt
index b69e35d931..f4f885ae3f 100644
--- a/src/com/android/launcher3/deviceprofile/AllAppsProfile.kt
+++ b/src/com/android/launcher3/deviceprofile/AllAppsProfile.kt
@@ -134,8 +134,15 @@ data class AllAppsProfile(
             typeIndex: Int,
             scale: Float,
         ): AllAppsProfile {
-            val allAppsBorderSpacePx = calculateAllAppsBorderSpacePx(inv, metric, typeIndex, scale)
-            val allAppsIconSizePx = max(1, pxFromDp(inv.allAppsIconSize[typeIndex], metric, scale))
+            // Device hook: a panel too short for the workspace grid gets a scale-to-fit
+            // factor that upstream also applies to the all-apps grid, although all-apps
+            // scrolls and never has to fit. Let a device keep the drawer at full size.
+            val allAppsScale =
+                if (res.getBoolean(R.bool.all_apps_ignore_workspace_scale)) 1f else scale
+            val allAppsBorderSpacePx =
+                calculateAllAppsBorderSpacePx(inv, metric, typeIndex, allAppsScale)
+            val allAppsIconSizePx =
+                max(1, pxFromDp(inv.allAppsIconSize[typeIndex], metric, allAppsScale))
             val allAppsIconDrawablePaddingPx =
                 res.getDimensionPixelSize(R.dimen.all_apps_icon_drawable_padding)
             return AllAppsProfile(
@@ -148,7 +155,8 @@ data class AllAppsProfile(
                 iconSizePx = allAppsIconSizePx,
                 // We need the double conversion to keep the original behaviour
                 iconTextSizePx =
-                    (pxFromSp(inv.allAppsIconTextSize[typeIndex], metric).toFloat() * scale)
+                    (pxFromSp(inv.allAppsIconTextSize[typeIndex], metric).toFloat() *
+                            allAppsScale)
                         .toInt()
                         .toFloat(),
                 iconDrawablePaddingPx = allAppsIconDrawablePaddingPx,
